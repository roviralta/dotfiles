/* ==========================================================
   Rofi Config - Catppuccin Mocha Minimalist Style
   ========================================================== */

configuration {
    show-icons: true;
    modi: "drun,run,window";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
}

/* -----------------------------
   Global colors & base style
   ----------------------------- */

* {
    /* Paleta Catppuccin Mocha */
    bg: #1e1e2e;          /* Base oscura */
    bg-alt: #313244;      /* Superficie (para selecciones) */
    bg-soft: #45475a;     /* Superficie más clara */
    fg: #cdd6f4;          /* Texto principal */
    fg-alt: #bac2de;      /* Texto secundario */
    cyan: #89b4fa;        /* Acento Azul (para selección) */
    blue: #cba6f7;        /* Acento Lavanda/Malva */
    border-clr: #b4befe;  /* Borde Lavanda sutil */
    disabled: #6c7086;    /* Texto apagado */

    font: "JetBrainsMono Nerd Font 11";

    background-color: transparent;
    text-color: @fg;

    margin: 0;
    padding: 0;
    spacing: 0;
}

/* -----------------------------
   Main window
   ----------------------------- */

#window {
    width: 35%;
    location: center;
    anchor: center;

    background-color: @bg;
    border: 2px; /* Un pelín más grueso para destacar el borde Catppuccin */
    border-color: @border-clr;
    border-radius: 10px;
}

/* -----------------------------
   Main layout
   ----------------------------- */

#mainbox {
    background-color: @bg;
    padding: 0;
    spacing: 0;
}

/* -----------------------------
   Input bar
   ----------------------------- */

#inputbar {
    background-color: @bg-alt;
    padding: 14px;
    spacing: 10px;

    border: 0 0 1px 0;
    border-color: @bg-soft;
}

#prompt {
    background-color: transparent;
    text-color: @cyan;
}

#entry {
    background-color: transparent;
    text-color: @fg;
}

#case-indicator {
    background-color: transparent;
    text-color: @disabled;
}

/* -----------------------------
   List view
   ----------------------------- */

#listview {
    background-color: @bg;
    padding: 0;
    margin: 0;
    spacing: 0;

    lines: 8;
    dynamic: true;
    scrollbar: true;
}

/* -----------------------------
   Elements
   ----------------------------- */

#element {
    background-color: @bg;
    padding: 12px 16px;

    border: 0 0 1px 0;
    border-color: @bg-alt;
}

#element.normal.normal {
    background-color: @bg;
    text-color: @fg;
}

#element.alternate.normal {
    background-color: @bg;
    text-color: @fg;
}

#element.selected.normal {
    background-color: @bg-alt;
    text-color: @cyan;
}

#element.normal.active {
    background-color: @bg-soft;
    text-color: @fg-alt;
}

#element.alternate.active {
    background-color: @bg-soft;
    text-color: @fg-alt;
}

#element.selected.active {
    background-color: @bg-alt;
    text-color: @cyan;
}

#element-icon {
    background-color: transparent;
    size: 1.2em;
    margin: 0 10px 0 0;
}

#element-text {
    background-color: transparent;
    text-color: inherit;
}

/* -----------------------------
   Scrollbar
   ----------------------------- */

#scrollbar {
    background-color: @bg;
    width: 5px;
    border: 0;
    handle-color: @cyan;
}
